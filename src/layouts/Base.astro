---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../config';

const fm = Astro.props.frontmatter ?? {};
const title: string = fm.title ?? Astro.props.title ?? SITE_NAME;
const description: string = fm.description ?? Astro.props.description ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const current = Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.startsWith('/privacy') ? 'privacy' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="wordmark" href="/">{SITE_NAME}</a>
        <Nav current={current} />
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
