---
import Shot from './Shot.astro';
import { screen, hasScreen } from '../lib/screens';
import { copyFor } from '../i18n.mjs';

interface Props { lang: string }
const { lang } = Astro.props;
const { shots } = copyFor(lang);
const phone = screen(lang, 'iphone-month');
const ipad = hasScreen('ipad-hero') ? screen(lang, 'ipad-hero') : undefined;
---
<div class="stage" role="group" aria-label={shots.group}>
  <div class="rig">
    {ipad && (
      <div class="dev ipad">
        <Shot light={ipad.light} dark={ipad.dark} width={900} loading="lazy" alt={shots.ipad} />
      </div>
    )}
    <div class="dev iphone">
      <Shot light={phone.light} dark={phone.dark} width={600} loading="eager" alt={shots.iphone} />
    </div>
  </div>
</div>
<script>
  // Load the 3D devices; they fade in once ready. If they fail, or are slow, the screenshots fade in instead.
  // <html> gets .will-3d from the inline script in index.astro's <head> when the page opens wide enough; a page
  // opened narrower loads them if the window is later widened.
  const html = document.documentElement;
  const stage = document.querySelector<HTMLElement>('.stage');
  const wide = matchMedia('(min-width: 821px)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const flat = () => html.classList.remove('will-3d');
  const load = (stage: HTMLElement) => {
    const slow = setTimeout(flat, 6000);
    import('../scripts/devices3d')
      .then((m) => m.mount(stage, { iphone: '/models/iphone.glb', ipad: '/models/ipad.glb' }))
      .then((shown) => { if (shown) clearTimeout(slow); else flat(); }, flat);
  };
  if (!stage?.querySelector('.ipad')) flat();
  else if (html.classList.contains('will-3d')) load(stage);
  else if (!saveData && 'WebGL2RenderingContext' in window) {
    const widened = () => { if (wide.matches) { wide.removeEventListener('change', widened); load(stage); } };
    wide.addEventListener('change', widened);
  }
</script>
