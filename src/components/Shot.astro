---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { light: ImageMetadata; dark?: ImageMetadata; alt: string; width: number; loading?: 'eager' | 'lazy' }
const { light, dark, alt, width, loading = 'lazy' } = Astro.props;
const l = await getImage({ src: light, width, format: 'webp' });
const d = dark ? await getImage({ src: dark, width, format: 'webp' }) : undefined;
---
<picture>
  {d && <source media="(prefers-color-scheme: dark)" srcset={d.src} type="image/webp" />}
  <img src={l.src} width={l.attributes.width} height={l.attributes.height} alt={alt} loading={loading} decoding="async" />
</picture>
