---
import { privacy } from '../data/copy.mjs';

const icons: Record<string, string> = {
  account: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4 4-5.5 7-5.5s6 1.5 7 5.5"/><path d="M4 4l16 16"/>',
  device: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  tracking: '<path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
};
---
<section class="band" aria-labelledby="privacy-title">
  <div class="wrap">
    <p class="eyebrow eyebrow-on-dark">{privacy.eyebrow}</p>
    <h2 id="privacy-title">{privacy.title}</h2>
    <p class="band-lead">{privacy.lead}</p>
    <ul class="tiles">
      {privacy.tiles.map((t) => (
        <li class="tile">
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.key]} />
          </span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
