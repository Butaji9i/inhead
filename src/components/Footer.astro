---
import { SITE_NAME, CONTACT_EMAIL } from '../config';
import { modelCredits } from '../data/copy.mjs';
import { copyFor, ui, localePath, LANGS, LANG_META } from '../i18n.mjs';

interface Props { lang: string; base: string }
const { lang, base } = Astro.props;
const { footer, disclaimer } = copyFor(lang);
const t = ui[lang];
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      <div><h2>{SITE_NAME}</h2><p>{footer.blurb}</p></div>
      <div><h2>{t.support}</h2><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></div>
      <div><h2>{t.site}</h2><a href={localePath(lang, '/')}>{t.home}</a><a href={localePath(lang, '/privacy/')}>{t.privacyPolicy}</a></div>
      <div><h2>{t.language}</h2>{LANGS.map((l) => (
        <a href={localePath(l, base)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{LANG_META[l].name}</a>
      ))}</div>
    </div>
    <p class="disc">{disclaimer}<br />© {SITE_NAME}</p>
    <p class="credits">{t.models}:{modelCredits.map((m, i) => <>{i ? ';' : ''} <a href={m.url}>{m.what}</a> {t.by} {m.by}</>)}, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  </div>
</footer>
