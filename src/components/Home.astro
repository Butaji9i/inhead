---
// The home page, in any of the site's languages; src/pages/index.astro, ru/index.astro and cs/index.astro render it.
// Day to night, in the App Store screenshots' style: the sky with the live diary line
// and the hills, the feature on the deepest hill blue, one headache hour by hour, the questions, then night.
import Base from '../layouts/Base.astro';
import StoreLabel from './StoreLabel.astro';
import LiveLine from './LiveLine.astro';
import Night from './Night.astro';
import Shot from './Shot.astro';
import Faq from './Faq.astro';
import { copyFor, ui, localePath } from '../i18n.mjs';
import { painColor, eventLabel } from '../lib/liveline.mjs';
import { screen } from '../lib/screens';
import '../styles/landing.css';

interface Props { lang: string }
const { lang } = Astro.props;
const { hero, rise, hours, live, shots, faq, painPage } = copyFor(lang);
const t = ui[lang];
const episode = screen(lang, 'ipad-hero');
const day = screen(lang, 'iphone-all');
// The same headache as the line above: its times and pain levels, beside the words in `hours.steps`.
const STOPS = [{ time: '09:00', level: 3 }, { time: '12:00', level: 8 }, { time: '17:00', level: 0, ended: true }];
const steps = hours.steps.map((s: { title: string; text: string }, i: number) => ({ ...s, ...STOPS[i] }));
---
<Base title={t.homeTitle} description={t.homeDescription} faq={faq.items} bodyClass="scenic">
  <section class="sky" aria-labelledby="hero-title">
    <div class="wrap sky-hero">
      <h1 id="hero-title">{hero.headline} <span class="accent">{hero.accent}</span></h1>
      <p class="lede">{hero.lede}</p>
      <StoreLabel lang={lang} />
      <p class="note">{hero.note}</p>
    </div>
    <LiveLine lang={lang} />
  </section>

  <section class="rise" aria-labelledby="rise-title">
    <div class="wrap rise-grid">
      <div>
        <h2 id="rise-title">{rise.title}<br /><span class="accent">{rise.accent}</span></h2>
        <p>{rise.text}</p>
        <a class="rise-more" href={localePath(lang, '/pain-over-time/')}>{painPage.homeLink}</a>
      </div>
      <div class="frame-ipad">
        <div class="frame-ipad-screen"><Shot light={episode.light} dark={episode.dark} width={1100} alt={shots.ipad} /></div>
      </div>
    </div>
  </section>

  <section class="hours" aria-labelledby="hours-title">
    <div class="wrap hours-grid">
      <div>
        <h2 id="hours-title">{hours.title}<br /><span class="accent">{hours.accent}</span></h2>
        <ol class="hour-list">
          {steps.map((s) => (
            <li class="hour">
              <div class="hour-when">
                <span class="hour-time">{s.time}</span>
                {s.ended
                  ? <span class="hour-ended">{live.names.end}</span>
                  : <span class="scale" role="img" aria-label={eventLabel({ kind: 'pain', level: s.level }, live.names, live.pain)}>
                      {Array.from({ length: 10 }, (_, i) => <span style={i < s.level ? `background:${painColor(s.level)}` : undefined} />)}
                    </span>}
              </div>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="frame-phone"><Shot light={day.light} dark={day.dark} width={600} alt={shots.record} /></div>
    </div>
  </section>

  <Faq title={faq.title} items={faq.items} />

  <Night lang={lang} />
</Base>
