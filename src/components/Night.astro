---
// The end of a page, at night: privacy (the home page; `privacy={false}` leaves it out), then the call to action
// over the night hills with the amber rim line along the top one. The hills drift with the line above
// (src/scripts/liveline.ts). `cta` replaces the home page's call to action.
import StoreLabel from './StoreLabel.astro';
import { hillShape, hillLine, HILLS } from '../lib/liveline.mjs';
import { copyFor } from '../i18n.mjs';

interface Props { lang: string; privacy?: boolean; cta?: { title: string; text: string } }
const { lang, privacy: withPrivacy = true } = Astro.props;
const { privacy } = copyFor(lang);
const cta = Astro.props.cta ?? copyFor(lang).cta;
const W = 1440;
const H = HILLS.night.height;
const [top, ...rest] = HILLS.night.layers;
const icons: Record<string, string> = {
  account: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4 4-5.5 7-5.5s6 1.5 7 5.5"/><path d="M4 4l16 16"/>',
  device: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  tracking: '<path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
};
// A few fixed stars: left %, top px, size px.
const stars = [[8, 70, 2], [17, 160, 3], [29, 40, 2], [44, 120, 2], [58, 60, 3], [71, 150, 2], [83, 50, 2], [92, 130, 3]];
---
<section class:list={['night', { 'night-short': !withPrivacy }]} aria-labelledby={withPrivacy ? 'privacy-title' : 'night-cta-title'}>
  {stars.map(([l, t, s]) => <span class="star" aria-hidden="true" style={`left:${l}%;top:${t}px;width:${s}px;height:${s}px`} />)}
  {withPrivacy && <div class="wrap night-inner">
    <img class="night-icon" src="/icon-192.png" alt="" width="88" height="88" />
    <h2 id="privacy-title">{privacy.title}<br /><span class="accent">{privacy.accent}</span></h2>
    <p class="night-lead">{privacy.lead}</p>
    <ul class="night-tiles">
      {privacy.tiles.map((t) => (
        <li>
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.key]} /></span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>
  </div>}
  <div class="night-end">
    <div class="night-cta">
      <h2 id="night-cta-title">{cta.title}</h2>
      <p>{cta.text}</p>
      <StoreLabel lang={lang} />
    </div>
    <svg class="hills hills-night" data-hills="night" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="rim" x1="0" x2="1">
          <stop offset="0" stop-color="#E0A444" stop-opacity="0" /><stop offset="0.5" stop-color="#F0B25A" stop-opacity="0.95" /><stop offset="1" stop-color="#E0A444" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={hillShape(top, 0, W, H)} />
      <path class="rim" data-rim d={hillLine(top, 0, W)} />
      {rest.map((h) => <path d={hillShape(h, 0, W, H)} />)}
    </svg>
  </div>
</section>
